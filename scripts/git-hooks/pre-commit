#!/bin/bash
#
# git pre-commit：**提交前强制跑录音健康检查。**
#
# 安装（`scripts/git-hooks/` 是版本控制里的真身，`.git/hooks/` 不进版本控制）：
#
#     cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# ## 为什么挂在这里
#
# 用户 2026-09-28 的问题：「怎么样才能让 AI 知道他的修改已经让麦克风无法正常使用？
# 如果他修改完之后没有读到什么程序……那他就不知道。」
#
# 「提交」是这个项目改完代码的**必经一步**（CLAUDE.md 的流程以提交收尾），所以把它挂
# 在这里，"检查录音还活着吗"就不再依赖任何人记得 —— **git 自己会拦**。
#
# ## ⚠️ 为什么**没有**把采集探针挂进来（2026-09-28 实测）
#
# 原本的设计是：碰到音频文件就加 `--probe`，真跑一次 `recording-capture-probe.swift`。
# **实测当天发现它今天会假报失败，所以没挂。**
#
# 它第 ③ 步建的是 `AVAudioEngine`，复现的是「语音处理跑过之后，录音引擎声明
# 44100Hz/2ch 而设备是 1ch」—— 而**长录音早就不用 `AVAudioEngine` 取流了**，
# 它走 AUHAL（正是为了修好这一类，见 `开发经验/15-录音采集与设备自愈.md` §六）。
# 所以那个 ❌ 测的是录音**已经不走的那条路**：挂进来就等于为一个不存在的问题
# 拦住每一次提交 —— 那是"把好的判成坏"，比不判更坏。
#
# **谁该来修**：把探针第 ③ 步改成测 **AUHAL** 那条路（"语音处理跑过之后，
# 新起的 AUHAL 采集照样拿到非零样本、格式与设备一致"），它才重新有资格当闸门。
# 在那之前，这一层的判据只有下面那条 —— **App 自己写的自检行**。
#
# ## 两档力度
#
# · **任何提交**都跑一次快检查（读日志，<1 秒）：App 自己写的那一行自检若是 ⚠️，
#   提交被拒 —— 免得"麦克风已经坏了，还接着提交二十笔别的改动"。
# · **碰到音频相关文件**时把要求说清楚：这一档需要**最近真的有一场录音**才算验过；
#   日志里没有自检行时脚本会打 `⚠️ 未验证`，按 CLAUDE.md 的规矩要**让用户录 30 秒**。
#
# 不要用 `git commit --no-verify` 绕过它。绕过的前提是你已经用别的方式证明了录音是好的，
# 而这个仓库今天没有"别的方式"。
#
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/scripts/recording-health-check.sh"

# ══════════════════════════════════════════════════════════════════════════
# 闸门二：《项目全貌》必须同一次提交里更新（用户 2026-09-29 要求）
# ══════════════════════════════════════════════════════════════════════════
#
# 用户原话：「【做成一个闸门，提交 git 前，必须修改】否则不能提交，
# 目的让用户审核整体功能是否改变」。
#
# 为什么它必须挂在**机器**上：`全局框架/00-项目全貌.md` 是**给用户看的**
# ——他在上面提修改方案、判断系统是什么样。它一过期，用户就**照着一张错的图做决定**。
# 而"记得更新它"这件事，我今天（2026-09-29）刚写进 CLAUDE.md §0.7，
# **然后立刻自己违反了两次** —— 靠自觉就是靠不住，所以挂到 git 上。
#
# 判据：**碰了功能文件**（Wanna/ 下的 .swift、WannaAgent/ 下的 .py），
# 就必须**同时**提交 `全局框架/00-项目全貌.md`。
#
# 真遇到"改了文件但确实没改功能"（注释、typo）：用
#     WANNA_SKIP_OVERVIEW_GATE=1 git commit ...
# 显式跳过 —— **它是一次有意识的决定，不是默认路径**。
OVERVIEW="全局框架/00-项目全貌.md"
# ⚠️ **必须关掉 quotepath**：默认情况下 git 会把非 ASCII 路径转义
# （「全局框架/00-项目全貌.md」变成一串 \345\205\250…），于是任何
# `grep "中文路径"` 都**永远不会命中** —— 而这道闸门要认的正是一个中文路径。
# 2026-09-29 实测踩到：闸门二因此一直看不见那一篇，等于没装。
STAGED_FILES="$(git -c core.quotepath=false diff --cached --name-only)"
FUNCTIONAL="$(echo "$STAGED_FILES" | grep -E '^(Wanna/.*\.swift|WannaAgent/.*\.py|WannaAgent/requirements\.txt)$' || true)"

if [ -n "$FUNCTIONAL" ] && ! echo "$STAGED_FILES" | grep -qF "$OVERVIEW"; then
    if [ "${WANNA_SKIP_OVERVIEW_GATE:-0}" != "1" ]; then
        echo
        echo "⛔ 提交被拒：改了功能，但《项目全貌》没跟着改。"
        echo
        echo "   这次碰到的功能文件："
        echo "$FUNCTIONAL" | sed 's/^/     /'
        echo
        echo "   缺的那一份：$OVERVIEW"
        echo
        echo "   为什么拦：那一篇是**给用户看的**——他在上面判断系统是什么样、"
        echo "   在上面提修改方案。它一过期，他就照着一张错的图做决定。"
        echo
        echo "   怎么过："
        echo "     · 改了功能  → 把 $OVERVIEW 里对应那一节改掉，一起 git add"
        echo "     · 确实没改功能（注释 / typo / 纯重构）→"
        echo "         WANNA_SKIP_OVERVIEW_GATE=1 git commit ..."
        echo
        exit 1
    fi
    echo "⚠️ 跳过了《项目全貌》闸门（WANNA_SKIP_OVERVIEW_GATE=1）—— 请确认这次确实没改功能。"
fi

# ══════════════════════════════════════════════════════════════════════════
# 闸门三：《项目全貌》里说的数字和名字，与实际对不对（用户 2026-09-29 要求"写入"）
# ══════════════════════════════════════════════════════════════════════════
#
# 闸门二只管「你**改没改**那一篇」，不管「你**改得对不对**」。
# 2026-09-29 我犯的八次错里，有两次正是"改了、但改错了"：
#   · 文档写「10 个工具」—— 实际 18（后来加了 8 个，忘了回头改这个数）
#   · 文档写「命令 ×2」放在 Python 底下 —— 而 Python 根本没有跑命令的工具
# 两次都不是代码改错，是**描述现状时靠记忆、不靠核实**。
#
# 所以这一道：**动了《项目全貌》就自动去数一遍** —— 工具数、技能数、
# 图里列的每个工具名、位置表里每条路径。对不上直接拒。
#
# ⚠️ 它**只**管能用机器数出来的东西。措辞对不对、这张图讲清楚没有、
# 某个说法是不是已经过期 —— 仍然只能靠人（也仍然会错）。
FACTCHECK="$ROOT/scripts/overview-fact-check.sh"
if echo "$STAGED_FILES" | grep -qF "全局框架/00-项目全貌.md" && [ -x "$FACTCHECK" ]; then
    if ! "$FACTCHECK"; then
        echo
        echo "⛔ 提交被拒：《项目全貌》里说的数字 / 名字，和实际对不上。"
        echo "   它是给用户看的 —— 他会照着一张错的图做决定。"
        echo
        exit 1
    fi
fi

[ -x "$CHECK" ] || { echo "⚠️ 找不到 $CHECK，跳过录音健康检查。"; exit 0; }

# 这次提交碰到的文件里，有没有"能影响录音"的
AUDIO_PATTERN='VoicePlaybackEngine|BuddyDictationManager|LongFormRecorderController|VolcengineRealtimeASR|VolcengineASRFrame|RecordingAudioWriter|LongFormTranscriptWriter|AudioInputDeviceCatalog|RecordingPolish|SystemSpeakerMute|AudioInputDevice'
touched="$(git diff --cached --name-only | grep -E "$AUDIO_PATTERN" || true)"

if [ -n "$touched" ]; then
    echo "── 这次提交动了音频相关的文件："
    echo "$touched" | sed 's/^/     /'
    echo '── 所以这一档要求「最近真的有一场录音」当判据（见 CLAUDE.md 那一节）'
    echo
fi

exec "$CHECK"
